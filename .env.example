# Copy to .env and fill in. Compose overrides DATABASE_URL and S3_ENDPOINT_URL
# for the containers; these values are for running the API directly on the host.
#
# Nothing here is a real credential. The live .env is gitignored on purpose:
# it carries the Ably root key, the Upstash token and the JWT signing secret.

# Local compose Postgres (port 5433 on the host).
DATABASE_URL=postgresql://gora:gora-local@localhost:5433/gora_v2?sslmode=disable

JWT_SECRET=change-me-to-something-long-and-random
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
# Password-reset links live in an inbox, so they expire quickly.
JWT_RESET_TTL_MINUTES=30
# A verification link proves an address and grants nothing, so it can be patient.
JWT_VERIFY_TTL_HOURS=72

# Object storage. MinIO locally, Cloudflare R2 later - both speak S3, so the
# move is these four values and no code. S3_PUBLIC_URL is the host a phone can
# actually resolve, which is not the one the API uses internally.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
# Optional public catalog bucket root. For production: https://cdn.gimik.app
S3_CATALOG_PUBLIC_URL=
S3_ACCESS_KEY=gora-local
S3_SECRET_KEY=gora-local-secret
S3_BUCKET=gora-user-media
S3_CATALOG_BUCKET=gora-catalog
S3_REGION=auto

# Realtime. The root key never leaves the API: clients get scoped, short-lived
# tokens from POST /realtime/token. Leave blank to disable realtime entirely.
ABLY_API_KEY=
ABLY_TOKEN_TTL_SECONDS=3600

# Rate limiting. Blank disables it; the limiter also fails open if Redis is
# unreachable, because a broken limiter must not take the API down.
# Compose provides this as redis://redis:6379/0.
REDIS_URL=

# Mail. These production defaults use ZeptoMail over STARTTLS. Blank
# SMTP_HOST disables delivery. Local compose overrides the host and port with
# Mailpit; leave its username/password empty there.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=Gimik <noreply@gimik.app>
APP_BASE_URL=https://gimik.app
# The deep-link scheme a password-reset email points at.
APP_SCHEME=gimik
# QStash holds and retries production email. It POSTs signed messages back to
# the API; the callback URL must match the public endpoint exactly.
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_EMAIL_CALLBACK_URL=https://api.gimik.app/internal/qstash/email

# Error monitoring. Blank disables it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Places Autocomplete, server-side only. Restrict the key to the Places
# API, and to this server's addresses once it has a fixed one - an unrestricted
# Maps key is billable by anyone who finds it.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Backend only; never EXPO_PUBLIC_. Jobs are drained by scripts/assess_places.py.
OPENAI_API_KEY=
PLACE_ASSESSMENT_MODEL=gpt-4o-mini
PLACE_SEARCH_RETENTION_DAYS=90

# RevenueCat V1 customer lookup: a public goog_/appl_ SDK key is sufficient.
# Do not use the V2 management secret. Webhook auth must be 32+ random characters,
# identical to the Authorization header configured in the RevenueCat dashboard.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Comma-separated Gimik user UUIDs permitted to use sandbox purchases for QA.
REVENUECAT_SANDBOX_USER_IDS=

# Google sign-in. A Google ID token names the client it was minted for, and that
# client differs by platform: the Android library must be handed the *web* id to
# return a token at all, while iOS uses its own. Both are accepted audiences.
# Leave blank to disable Google sign-in entirely.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Only needed if we ever move to a server-side authorization-code exchange.
GOOGLE_CLIENT_SECRET=

ENVIRONMENT=development
CORS_ORIGINS=
